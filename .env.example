# Pet Echo — Environment template
# Copy to .env.development and fill in your Supabase cloud values.
# Get keys from: https://supabase.com/dashboard → Project Settings → API

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
